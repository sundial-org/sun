    "@pierre/theme": "2.0.0",
    "@pierre/theming": "1.0.2"
  },
  "devDependencies": {
    "@playwright/test": "1.51.1",
    "@tsdown/css": "0.22.14",
    "@types/hast": "3.0.4",
    "@types/jsdom": "28.0.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.4.22",
    "jsdom": "26.1.0",
    "lightningcss": "1.32.0",
    "postcss": "8.5.6",
    "postcss-calc": "10.1.1",
    "postcss-nesting": "14.0.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "vite": "8.1.0"
